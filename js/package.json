{
  "name": "yq-nova",
  "version": "0.3.0",
  "description": "JavaScript/TypeScript SDK for the yq-nova agent memory service",
  "keywords": ["memory", "agent", "ai", "semantic-search", "graph", "sqlite", "llm"],
  "license": "BSL-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}